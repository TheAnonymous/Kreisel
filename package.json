{
  "name": "kreisel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@12.0.0",
  "engines": {
    "node": "24.15.0",
    "npm": "12.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "level": "node scripts/level-sounds.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "klangwerk": "github:TheAnonymous/Klangwerk#bfd31d4a203bf9aca240eb1a1260bdad6620edd2"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
